{
  "name": "@nandenjin/obakesan",
  "version": "0.2.3",
  "description": "A monitor or converter app for stage lighting system",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win --config electron-builder.config.js --publish never",
    "build:mac": "npm run build && dotenvx run -- electron-builder --mac --universal --config electron-builder.config.js --publish never",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.config.js --publish never",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [],
  "author": "Kazumi Inada <hello@nandenjin.com>",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fontsource/roboto-mono": "5.2.9",
    "consola": "3.4.2",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "ftdi-d2xx": "1.3.1",
    "pinia": "3.0.4",
    "vue": "3.5.38"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.74.3",
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.7",
    "electron": "41.8.0",
    "electron-builder": "26.15.3",
    "electron-devtools-installer": "4.0.0",
    "electron-vite": "5.0.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "typescript-eslint": "8.61.1",
    "vitepress": "2.0.0-alpha.17",
    "vue-tsc": "3.3.5"
  }
}
