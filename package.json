{
  "name": "@nandenjin/obakesan",
  "version": "0.2.2",
  "description": "A monitor or converter app for stage lighting system",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win --config electron-builder.config.js --publish never",
    "build:mac": "npm run build && dotenvx run -- electron-builder --mac --universal --config electron-builder.config.js --publish never",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.config.js --publish never",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [],
  "author": "Kazumi Inada <hello@nandenjin.com>",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fontsource/roboto-mono": "5.2.8",
    "consola": "3.4.2",
    "electron-log": "5.4.3",
    "electron-updater": "6.8.3",
    "ftdi-d2xx": "1.3.1",
    "pinia": "3.0.4",
    "vue": "3.5.30"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.54.1",
    "@eslint/js": "9.39.4",
    "@vitejs/plugin-vue": "6.0.5",
    "electron": "39.8.0",
    "electron-builder": "26.8.1",
    "electron-devtools-installer": "4.0.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "typescript-eslint": "8.57.0",
    "vitepress": "2.0.0-alpha.16",
    "vue-tsc": "3.2.5"
  }
}
