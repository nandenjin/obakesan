    "vue": "3.5.25"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.51.1",
    "@eslint/js": "9.39.1",
    "@vitejs/plugin-vue": "6.0.2",
    "electron": "39.2.6",
    "electron-builder": "26.0.12",
    "electron-devtools-installer": "4.0.0",
